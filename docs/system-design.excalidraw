      "index": "b0i",
      "roundness": null,
      "seed": 1996993237,
      "version": 1,
      "versionNonce": 1590189070,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1758540000000,
      "link": null,
      "locked": false,
      "text": "IN : extraction + outcome + provenance\n     (id from UlidGenerator, now() from\n      SystemClock \u2014 injected, so tests\n      are deterministic)\nOUT: Decision {\n  id, created_at, letter_text,\n  letter_sha256, model_id, prompt_version,\n  extractor_provider, raw_llm_response,\n  extraction,            <- INPUT\n  ---- derived, stored as evidence ----\n  field_confidences, operative_amount,\n  operative_amount_reason, both indices,\n  doctrine_version, fired_rules,\n  decisive_rule_id, route, reasons,\n  routing_version }",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "IN : extraction + outcome + provenance\n     (id from UlidGenerator, now() from\n      SystemClock \u2014 injected, so tests\n      are deterministic)\nOUT: Decision {\n  id, created_at, letter_text,\n  letter_sha256, model_id, prompt_version,\n  extractor_provider, raw_llm_response,\n  extraction,            <- INPUT\n  ---- derived, stored as evidence ----\n  field_confidences, operative_amount,\n  operative_amount_reason, both indices,\n  doctrine_version, fired_rules,\n  decisive_rule_id, route, reasons,\n  routing_version }",
      "autoResize": true,
      "lineHeight": 1.25
    },
