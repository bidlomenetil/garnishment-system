      "link": null,
      "locked": false,
      "text": "Decision log line (12 keys, UTC ISO time, propagate=False):\ndecision_id, route, decisive_rule, letter_sha256, provider,\nmodel_id, prompt_version, routing_version, extraction_status,\nlatency_ms, llm_ms, db_ms.   Never: letter text, names, IBAN.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
