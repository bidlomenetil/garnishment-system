    {
      "id": "Es6f1UwvYHwgUCecTbvgZ",
      "type": "text",
      "x": 4000,
      "y": 3600,
      "width": 682,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
