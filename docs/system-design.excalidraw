      "isDeleted": false,
      "boundElements": null,
      "updated": 1758540000000,
      "link": null,
      "locked": false,
      "text": "SQLite row: scalars + JSON columns,\n  Decimal stored as str (exact),\n  enums as their string values,\n  raw payload byte-identical,\n  INSERT .. ON CONFLICT DO NOTHING\none JSON log line (12 keys):\n  decision_id, route, decisive_rule,\n  letter_sha256, provider, model_id,\n  prompt_version, routing_version,\n  extraction_status, latency_ms,\n  llm_ms, db_ms\nappend-only: no PATCH, no delete",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SQLite row: scalars + JSON columns,\n  Decimal stored as str (exact),\n  enums as their string values,\n  raw payload byte-identical,\n  INSERT .. ON CONFLICT DO NOTHING\none JSON log line (12 keys):\n  decision_id, route, decisive_rule,\n  letter_sha256, provider, model_id,\n  prompt_version, routing_version,\n  extraction_status, latency_ms,\n  llm_ms, db_ms\nappend-only: no PATCH, no delete",
      "autoResize": true,
      "lineHeight": 1.25
    },
