      "locked": false,
      "text": "2b. RESOLVE AMOUNT\nresolve_operative_amount()",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "Kr7RrIQl2bnj007tKK2RI",
      "originalText": "2b. RESOLVE AMOUNT\nresolve_operative_amount()",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "yXsperyYjyxf8CWgfBJGg",
      "type": "text",
      "x": 2400,
      "y": 3600,
      "width": 763,
      "height": 560,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0c",
      "roundness": null,
      "seed": 192454994,
      "version": 1,
      "versionNonce": 760025142,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1758540000000,
      "link": null,
      "locked": false,
      "text": "IN : amount_candidates, document_type\nOUT: Resolution {\n  amount: Money | None   (parsed HERE from\n          value_as_written, never stored)\n  reason: no_amount | sole_candidate |\n    explicit_operative | restriction_supersedes\n    | restriction_unresolved | ambiguous |\n    unparseable\n  considered_candidate_index  (which figure\n    the letter pointed at)\n  source_candidate_index      (which one\n    actually parsed)\n  doctrine_version = RESTRICTION_DOCTRINE_V1\n}\nrole_confidence < 0.85 => ambiguous\nrestricted must be < original, else H12",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "IN : amount_candidates, document_type\nOUT: Resolution {\n  amount: Money | None   (parsed HERE from\n          value_as_written, never stored)\n  reason: no_amount | sole_candidate |\n    explicit_operative | restriction_supersedes\n    | restriction_unresolved | ambiguous |\n    unparseable\n  considered_candidate_index  (which figure\n    the letter pointed at)\n  source_candidate_index      (which one\n    actually parsed)\n  doctrine_version = RESTRICTION_DOCTRINE_V1\n}\nrole_confidence < 0.85 => ambiguous\nrestricted must be < original, else H12",
      "autoResize": true,
      "lineHeight": 1.25
    },
