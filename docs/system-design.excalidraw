      "version": 1,
      "versionNonce": 284951447,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1758540000000,
      "link": null,
      "locked": false,
      "text": "DecisionResponse {\n  id, created_at, route, decisive_rule_id,\n  reasons[], fired_rules[],\n  fields {\n    debtor_name    {value, evidence_quote,\n      confidence{llm,grounding,validator,final}}\n    case_reference {...}\n    amount {value=RESOLVED figure, currency,\n      ..., resolution{reason, role,\n      role_confidence, indices, doctrine}}\n    account_iban   {compact value, ...}\n  }\n  extraction { document_type, is_seizure_order\n    + conf, amount_candidates[], model_id,\n    prompt_version, routing_version }\n}\nGET /decisions/{id} = same + audit tail:\n  letter_text, letter_sha256,\n  raw_llm_response, extractor_provider,\n  doctrine_version",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DecisionResponse {\n  id, created_at, route, decisive_rule_id,\n  reasons[], fired_rules[],\n  fields {\n    debtor_name    {value, evidence_quote,\n      confidence{llm,grounding,validator,final}}\n    case_reference {...}\n    amount {value=RESOLVED figure, currency,\n      ..., resolution{reason, role,\n      role_confidence, indices, doctrine}}\n    account_iban   {compact value, ...}\n  }\n  extraction { document_type, is_seizure_order\n    + conf, amount_candidates[], model_id,\n    prompt_version, routing_version }\n}\nGET /decisions/{id} = same + audit tail:\n  letter_text, letter_sha256,\n  raw_llm_response, extractor_provider,\n  doctrine_version",
      "autoResize": true,
      "lineHeight": 1.25
    },
