      "boundElements": null,
      "updated": 1758540000000,
      "link": null,
      "locked": false,
      "text": "body: { \"letter_text\": \"DISTRICT COURT\n  OF EXAMPLETON ...\" }\n\nchecks before any LLM call:\n  Content-Length > 400 kB -> 413 (pre-parse)\n  blank after strip      -> 422\n  > 100 000 characters   -> 413\n  (out of scope: auth, OCR, PDF)",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "body: { \"letter_text\": \"DISTRICT COURT\n  OF EXAMPLETON ...\" }\n\nchecks before any LLM call:\n  Content-Length > 400 kB -> 413 (pre-parse)\n  blank after strip      -> 422\n  > 100 000 characters   -> 413\n  (out of scope: auth, OCR, PDF)",
      "autoResize": true,
      "lineHeight": 1.25
    },
